<idea-plugin>
    <id>com.springmodulith.plugin</id>
    <name>Spring Modulith Assistance</name>
    <vendor>SpringModulith</vendor>
    <description><![CDATA[
        Community-edition Spring Modulith assistance. Detects application modules from Java package structure,
        validates @ApplicationModule allowedDependencies, checks closed-module API access,
        validates named interfaces, provides package-info completion/navigation, event-listener simplification,
        project-view indicators, and a module overview tool window.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <localInspection language="JAVA" shortName="ModulithDependency" displayName="Spring Modulith API access"
                         groupName="Spring Modulith" enabledByDefault="true" level="WARNING"
                         implementationClass="com.springmodulith.plugin.inspection.ModulithApiUsageInspection"/>
        <localInspection language="JAVA" shortName="ModulithAllowedDependency" displayName="Spring Modulith allowed dependency"
                         groupName="Spring Modulith" enabledByDefault="true" level="ERROR"
                         implementationClass="com.springmodulith.plugin.inspection.ModulithAllowedDependencyInspection"/>
        <localInspection language="JAVA" shortName="ModulithEventListener" displayName="Spring Modulith event listener"
                         groupName="Spring Modulith" enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="com.springmodulith.plugin.inspection.ModulithEventListenerInspection"/>
        <projectConfigurable instance="com.springmodulith.plugin.configuration.ModulithConfigurable"
                             displayName="Spring Modulith"/>
        <completion.contributor language="JAVA" implementationClass="com.springmodulith.plugin.codeInsight.ModulithDependencyCompletionContributor" order="first"/>
        <psi.referenceContributor language="JAVA" implementation="com.springmodulith.plugin.codeInsight.ModulithDependencyReferenceContributor"/>
        <implicitUsageProvider implementation="com.springmodulith.plugin.codeInsight.ModulithImplicitUsageProvider"/>
        <projectViewNodeDecorator implementation="com.springmodulith.plugin.projectView.ModulithProjectViewNodeDecorator"/>
        <toolWindow id="Spring Modulith" anchor="right" factoryClass="com.springmodulith.plugin.toolwindow.ModulithToolWindowFactory"/>
    </extensions>
</idea-plugin>
