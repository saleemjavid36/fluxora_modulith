<idea-plugin>
    <id>com.springmodulith.plugin</id>

    <name>Spring Modulith Assistance</name>
    <vendor>SpringModulith</vendor>

    <description><![CDATA[
        IntelliJ IDEA assistance for detecting Spring Modulith-style module dependencies.
        The plugin analyzes Java project structure and package-level module boundaries.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <localInspection
                language="JAVA"
                shortName="ModulithDependency"
                displayName="Spring Modulith Dependency"
                groupName="Spring Modulith"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.springmodulith.plugin.inspection.ModulithDependencyInspection"/>
        <projectService
                serviceImplementation="com.springmodulith.plugin.configuration.ModulithSettings"/>
    </extensions>
</idea-plugin>