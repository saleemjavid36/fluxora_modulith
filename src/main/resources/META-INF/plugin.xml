<idea-plugin
        url="https://github.com/saleemjavid36/spring_modulithic_Asist"
>
    <id>com.springmodulith.plugin</id>

    <name>Spring Modulith Assistance</name>

    <vendor
            url="https://github.com/saleemjavid36"
            email="saleemjavid360@gmail.com">Fluxora</vendor>

    <description><![CDATA[
        Spring Modulith architecture assistance for IntelliJ IDEA.

        <p>
            Detect modules, analyze module dependencies, enforce allowed dependencies,
            validate API access, inspect named interfaces, and visualize your
            application architecture directly in the IDE.
        </p>

        <p><b>Features</b></p>

        <ul>
            <li>Automatic Spring Modulith module detection</li>
            <li>@ApplicationModule and allowedDependencies support</li>
            <li>Cross-module dependency inspections</li>
            <li>Named interface validation</li>
            <li>Module dependency cycle detection</li>
            <li>Event listener analysis</li>
            <li>Architecture verification</li>
            <li>Dependency graph visualization</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <actions>
        <action id="com.springmodulith.plugin.verifyArchitecture"
                class="com.springmodulith.plugin.action.ModulithVerifyArchitectureAction"
                text="Verify Spring Modulith Architecture"
                description="Verify all detected Spring Modulith module boundaries and dependencies">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.springmodulith.plugin.exportArchitecture"
                class="com.springmodulith.plugin.action.ModulithExportArchitectureAction"
                text="Export Spring Modulith Architecture"
                description="Export the detected Spring Modulith architecture as JSON, Mermaid, PlantUML, or Graphviz DOT">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.springmodulith.plugin.toggleToolWindow"
                class="com.springmodulith.plugin.action.ModulithToggleToolWindowAction"
                text="Toggle Spring Modulith Tool Window"
                description="Open or close the Spring Modulith tool window">

            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="ctrl shift alt M"/>
        </action>
    </actions>
    <extensions defaultExtensionNs="com.intellij">
        <annotator
                language="JAVA"
                implementationClass="com.springmodulith.plugin.inspection.ModulithBoundaryAnnotator"/>
        <completion.confidence
                language="JAVA"
                implementationClass="com.springmodulith.plugin.codeInsight.ModulithDependencyCompletionConfidence"
                order="before javaSkipAutopopupInStrings"/>
        <completion.contributor
                language="JAVA"
                implementationClass="com.springmodulith.plugin.codeInsight.ModulithDependencyCompletionContributor"
                order="first"/>

        <localInspection
                language="JAVA"
                shortName="ModulithDependency"
                displayName="Spring Modulith dependency"
                groupName="Spring Modulith"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.springmodulith.plugin.inspection.ModulithDependencyInspection"/>

        <localInspection
                language="JAVA"
                shortName="ModulithApiUsage"
                displayName="Spring Modulith API access"
                groupName="Spring Modulith"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.springmodulith.plugin.inspection.ModulithApiUsageInspection"/>

        <localInspection
                language="JAVA"
                shortName="ModulithAllowedDependency"
                displayName="Spring Modulith allowed dependency"
                groupName="Spring Modulith"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.springmodulith.plugin.inspection.ModulithAllowedDependencyInspection"/>
        <localInspection
                language="JAVA"
                shortName="ModulithCycle"
                displayName="Spring Modulith module dependency cycle"
                groupName="Spring Modulith"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.springmodulith.plugin.inspection.ModulithCycleInspection"/>
        <localInspection
                language="JAVA"
                shortName="ModulithEventListener"
                displayName="Spring Modulith event listener"
                groupName="Spring Modulith"
                enabledByDefault="true"
                level="WEAK WARNING"
                implementationClass="com.springmodulith.plugin.inspection.ModulithEventListenerInspection"/>

        <projectConfigurable
                instance="com.springmodulith.plugin.configuration.ModulithConfigurable"
                displayName="Spring Modulith"/>



        <psi.referenceContributor
                language="JAVA"
                implementation="com.springmodulith.plugin.codeInsight.ModulithDependencyReferenceContributor"/>

        <implicitUsageProvider
                implementation="com.springmodulith.plugin.codeInsight.ModulithImplicitUsageProvider"/>

        <projectViewNodeDecorator
                implementation="com.springmodulith.plugin.projectView.ModulithProjectViewNodeDecorator"/>

        <toolWindow
                id="Spring Modulith"
                anchor="right"
                factoryClass="com.springmodulith.plugin.toolwindow.ModulithToolWindowFactory"/>

    </extensions>
    <projectListeners>
        <listener
                topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"
                class="com.springmodulith.plugin.projectView.ModulithProjectViewNavigationListener"/>
    </projectListeners>
</idea-plugin>
