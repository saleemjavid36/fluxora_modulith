<idea-plugin
        url="https://github.com/saleemjavid36/fluxora_modulith"
>
    <id>com.fluxora.modulith</id>

    <name>Fluxora Modulith</name>

    <vendor
            url="https://github.com/saleemjavid36"
            email="saleemjavid360@gmail.com">Fluxora
    </vendor>

    <description><![CDATA[
        <h2>Spring Modulith architecture analysis for IntelliJ IDEA.</h2>
        <p>
        Fluxora Modulith helps Java and Spring developers understand, visualize, and enforce modular application boundaries directly inside IntelliJ IDEA.
        </p>

        <p>
        Designed for projects using <strong>Spring Modulith</strong> concepts, Fluxora Modulith analyzes your project's package structure, module dependencies, <code>@ApplicationModule</code> configuration, <code>allowedDependencies</code>, named interfaces, and architectural boundaries.
        </p>

        <h3>Features</h3>

        <ul>
        <li><strong>Spring Modulith module detection</strong> — Discover application modules from the current project structure.</li>
        <li><strong>Module dependency analysis</strong> — Detect dependencies between recognized application modules.</li>
        <li><strong>Architecture inspections</strong> — Identify unwanted cross-module dependencies directly in the editor.</li>
        <li><strong>@ApplicationModule support</strong> — Understand explicit module configuration and dependency rules.</li>
        <li><strong>allowedDependencies support</strong> — Validate dependencies against configured module boundaries.</li>
        <li><strong>Named interfaces</strong> — Define and validate module APIs and exposed interfaces.</li>
        <li><strong>Dependency cycle detection</strong> — Identify cycles between application modules.</li>
        <li><strong>Module Graph</strong> — Visualize relationships between application modules.</li>
        <li><strong>Module Structure</strong> — Explore packages and module boundaries from the IDE.</li>
        <li><strong>Quick fixes</strong> — Resolve supported architecture issues directly through IntelliJ intentions.</li>
        <li><strong>Module navigation</strong> — Navigate between modules, packages, and dependencies.</li>
        <li><strong>Architecture verification</strong> — Verify module boundaries and dependency rules from a dedicated verification view.</li>
        <li><strong>Architecture export</strong> — Export architecture information for documentation and analysis.</li>
        </ul>

        <h3>Built for real Java projects</h3>

        <p>
        Fluxora Modulith works from the current IntelliJ project structure and Java PSI rather than relying on application-specific package names or business logic. It is designed to work with different Java and Spring projects following Spring Modulith-style modular architecture.
        </p>

        <h3>Getting started</h3>

        <ol>
        <li>Install Fluxora Modulith from JetBrains Marketplace.</li>
        <li>Open a Java/Spring project.</li>
        <li>Open the Fluxora Modulith tool window.</li>
        <li>Explore your modules and dependencies.</li>
        <li>Use inspections and architecture verification to identify boundary issues.</li>
        </ol>

        <p>
        <a href="https://github.com/saleemjavid36">GitHub</a>
        </p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <actions>
        <action id="com.springmodulith.plugin.verifyArchitecture"
                class="com.springmodulith.plugin.action.ModulithVerifyArchitectureAction"
                text="Verify Spring Modulith Architecture"
                description="Verify all detected Spring Modulith module boundaries and dependencies">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.springmodulith.plugin.exportArchitecture"
                class="com.springmodulith.plugin.action.ModulithExportArchitectureAction"
                text="Export Spring Modulith Architecture"
                description="Export the detected Spring Modulith architecture as JSON, Mermaid, PlantUML, or Graphviz DOT">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.springmodulith.plugin.toggleToolWindow"
                class="com.springmodulith.plugin.action.ModulithToggleToolWindowAction"
                text="Toggle Spring Modulith Tool Window"
                description="Open or close the Spring Modulith tool window">

            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="ctrl shift alt M"/>
        </action>
    </actions>
    <extensions defaultExtensionNs="com.intellij">
        <annotator
                language="JAVA"
                implementationClass="com.springmodulith.plugin.inspection.ModulithBoundaryAnnotator"/>
        <completion.confidence
                language="JAVA"
                implementationClass="com.springmodulith.plugin.codeInsight.ModulithDependencyCompletionConfidence"
                order="before javaSkipAutopopupInStrings"/>
        <completion.contributor
                language="JAVA"
                implementationClass="com.springmodulith.plugin.codeInsight.ModulithDependencyCompletionContributor"
                order="first"/>

        <localInspection
                language="JAVA"
                shortName="ModulithDependency"
                displayName="Spring Modulith dependency"
                groupName="Spring Modulith"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.springmodulith.plugin.inspection.ModulithDependencyInspection"/>

        <localInspection
                language="JAVA"
                shortName="ModulithApiUsage"
                displayName="Spring Modulith API access"
                groupName="Spring Modulith"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.springmodulith.plugin.inspection.ModulithApiUsageInspection"/>

        <localInspection
                language="JAVA"
                shortName="ModulithAllowedDependency"
                displayName="Spring Modulith allowed dependency"
                groupName="Spring Modulith"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.springmodulith.plugin.inspection.ModulithAllowedDependencyInspection"/>
        <localInspection
                language="JAVA"
                shortName="ModulithCycle"
                displayName="Spring Modulith module dependency cycle"
                groupName="Spring Modulith"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.springmodulith.plugin.inspection.ModulithCycleInspection"/>
        <localInspection
                language="JAVA"
                shortName="ModulithEventListener"
                displayName="Spring Modulith event listener"
                groupName="Spring Modulith"
                enabledByDefault="true"
                level="WEAK WARNING"
                implementationClass="com.springmodulith.plugin.inspection.ModulithEventListenerInspection"/>

        <projectConfigurable
                instance="com.springmodulith.plugin.configuration.ModulithConfigurable"
                displayName="Spring Modulith"/>


        <editorFactoryMouseListener
                implementation="com.springmodulith.plugin.projectView.ModulithAllowedDependencyProjectViewListener"
                order="first"/>

        <psi.referenceContributor
                language="JAVA"
                implementation="com.springmodulith.plugin.codeInsight.ModulithDependencyReferenceContributor"/>

        <implicitUsageProvider
                implementation="com.springmodulith.plugin.codeInsight.ModulithImplicitUsageProvider"/>

        <projectViewNodeDecorator
                implementation="com.springmodulith.plugin.projectView.ModulithProjectViewNodeDecorator"/>

        <toolWindow
                id="Spring Modulith"
                anchor="right"
                factoryClass="com.springmodulith.plugin.toolwindow.ModulithToolWindowFactory"/>

    </extensions>
    <projectListeners>
        <listener
                topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"
                class="com.springmodulith.plugin.projectView.ModulithProjectViewNavigationListener"/>
    </projectListeners>
</idea-plugin>
